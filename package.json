{
  "name": "valorant",
  "version": "1.0.0",
  "description": "TypeScript library for interacting with VALORANT",
  "keywords": [
    "valorant",
    "riot",
    "api",
    "client",
    "nodejs",
    "typescript"
  ],
  "homepage": "https://github.com/sampreet-singh/valorant",
  "bugs": {
    "url": "https://github.com/sampreet-singh/valorant/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sampreet-singh/valorant.git"
  },
  "license": "MIT",
  "author": {
    "name": "Sampreet Singh",
    "url": "https://github.com/sampreet-singh"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "start": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  }
}
